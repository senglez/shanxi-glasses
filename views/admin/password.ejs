<%- include('_top', { title: '修改密码' }) %>
<h1>修改密码</h1>
<form class="card form narrow" method="post" action="/admin/password">
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field"><label>当前密码<input type="password" name="current" required autocomplete="current-password"></label></div>
  <div class="field"><label>新密码（至少 10 位）<input type="password" name="next" required minlength="10" autocomplete="new-password"></label></div>
  <div class="field"><label>确认新密码<input type="password" name="confirm" required minlength="10" autocomplete="new-password"></label></div>
  <div class="actions"><button class="btn">更新密码</button></div>
</form>
<%- include('_bottom') %>
