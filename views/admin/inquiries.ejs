<%- include('_top', { title: '询盘管理' }) %>
<div class="head-row">
  <h1>询盘管理 <small class="muted">共 <%= total %> 条</small></h1>
  <a class="btn ghost" href="/admin/inquiries.csv">导出 CSV</a>
</div>
<form class="filters" method="get">
  <select name="status">
    <option value="">全部状态</option>
    <% Object.entries(STATUSES).forEach(([k, v]) => { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= v %></option><% }) %>
  </select>
  <input name="q" value="<%= term %>" placeholder="搜索姓名 / 邮箱 / 公司 / 国家 / 内容">
  <button class="btn">筛选</button>
</form>
<div class="card flush">
<table class="tbl">
  <thead><tr><th>#</th><th>时间</th><th>客户</th><th>国家</th><th>产品 / 数量</th><th>来源</th><th>对接工厂</th><th>状态</th></tr></thead>
  <tbody>
  <% rows.forEach(r => { %>
    <tr class="<%= r.status === 'new' ? 'is-new' : '' %>">
      <td><a href="/admin/inquiries/<%= r.id %>"><%= r.id %></a></td>
      <td class="nowrap"><%= r.created_at %></td>
      <td><a href="/admin/inquiries/<%= r.id %>"><strong><%= r.name %></strong></a><br><span class="muted"><%= r.email %><%= r.company ? ' · ' + r.company : '' %></span></td>
      <td><%= r.country %></td>
      <td><%= r.product_name || '—' %><br><span class="muted"><%= r.quantity %></span></td>
      <td class="muted"><%= r.utm_source || '直接访问' %></td>
      <td><%= r.factory_name || '—' %></td>
      <td><span class="st st-<%= r.status %>"><%= STATUSES[r.status] || r.status %></span></td>
    </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="8" class="muted">没有询盘</td></tr><% } %>
  </tbody>
</table>
</div>
<% if (pages > 1) { %>
  <nav class="pager"><% for (let i = 1; i <= pages; i++) { %><a class="<%= i === page ? 'on' : '' %>" href="?status=<%= status %>&q=<%= encodeURIComponent(term) %>&page=<%= i %>"><%= i %></a><% } %></nav>
<% } %>
<%- include('_bottom') %>
