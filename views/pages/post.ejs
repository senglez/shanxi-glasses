<%- include('../partials/top') %>
<%- include('../partials/crumbs') %>
<article class="wrap article">
  <header>
    <h1><%= post.title %></h1>
    <p class="meta muted">
      By <%= post.author || s.site_name %> ·
      Published <time datetime="<%= post.published_at %>"><%= fmtDate(post.published_at) %></time> ·
      Updated <time datetime="<%= post.updated_at %>"><%= fmtDate(post.updated_at) %></time>
    </p>
    <% if (post.cover) { %><img class="cover" src="<%= post.cover %>" alt="<%= post.title %>" width="1200" height="630"><% } %>
  </header>
  <div class="prose"><%- md(post.body) %></div>
  <aside class="banner glass-panel">
    <div><h2>Sourcing glassware from China?</h2><p class="muted">Get factory options and prices from Shanxi within 1–3 days.</p></div>
    <a href="/contact" class="btn btn-glow btn-lg">Request a Quote</a>
  </aside>
</article>
<% if (more.length) { %>
<section class="wrap section-tight">
  <h2>More guides</h2>
  <div class="posts"><% more.forEach(m => { %><article class="post-card glass-panel"><h3><a href="/blog/<%= m.slug %>"><%= m.title %></a></h3><p><%= m.excerpt %></p></article><% }) %></div>
</section>
<% } %>
<%- include('../partials/bottom') %>
