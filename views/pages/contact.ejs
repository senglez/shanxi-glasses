<%- include('../partials/top') %>
<%- include('../partials/crumbs') %>
<section class="wrap section-tight cta-grid">
  <div>
    <h1>Request a quote</h1>
    <p class="lead muted">Tell us about your buying program. We’ll reply within 24 hours on business days with factory options, prices, MOQs and sample timing.</p>
    <p class="muted">We welcome inquiries from overseas importers, supermarket and homeware chains, gift retailers and brands. Share a current product, a target range or an OEM/private-label brief.</p>
    <ul class="checks">
      <li>Retail-ready glassware and gift programs</li>
      <li>OEM/private-label discussions for logo, color and packaging</li>
      <li>Quantity by design or color, destination and launch timing</li>
    </ul>
    <div class="glass-panel pad contact-box">
      <p><strong>Email</strong><br><a href="mailto:<%= s.contact_email %>"><%= s.contact_email %></a></p>
      <p><strong>Phone</strong><br><%= s.phone %></p>
      <% if (s.whatsapp) { %><p><strong>WhatsApp</strong><br><a href="<%= waLink() %>" target="_blank" rel="noopener">+<%= s.whatsapp %></a></p><% } %>
      <p><strong>Office</strong><br><%= s.address %></p>
    </div>
  </div>
  <%- include('../partials/inquiry-form') %>
</section>
<%- include('../partials/bottom') %>
