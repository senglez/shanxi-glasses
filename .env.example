# Copy to .env and fill in
NODE_ENV=production
PORT=3000
# Your real domain, no trailing slash (used in canonical URLs, sitemap, JSON-LD)
SITE_URL=https://www.your-domain.com
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# First admin account (only used when no admin exists yet)
ADMIN_USER=admin
ADMIN_PASSWORD=
# Reverse proxy (Nginx/Caddy on same machine): loopback; behind Cloudflare + Nginx: 2
TRUST_PROXY=loopback

# Inquiry email notifications (optional). Example: Tencent Exmail / Aliyun / Zoho / Gmail SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
